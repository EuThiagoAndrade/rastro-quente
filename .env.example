# Exemplo sem valores reais (ciclo 003). Copie para .env (ignorado pelo Git) só no ambiente do responsável.
# Google OAuth do Supabase Auth: preparado para o item 5; localmente o provedor fica desligado.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Papel executor (EX) da carga de dados: a senha só existe no ambiente do processo, durante a janela de carga.
# Nunca em argumento de comando, URL, arquivo versionado ou log. Ver docs/runbook.md.
RQ_EXECUTOR_PASSWORD=
# Interface (build do Vite): só valores públicos. Nunca a chave de serviço, a senha do EX ou o segredo do Google.
# URL do projeto Supabase e chave publicável (anon). Em https fora do loopback.
VITE_SUPABASE_URL=
VITE_SUPABASE_CHAVE_PUBLICAVEL=
# Somente build local de teste (loopback): habilita o login por e-mail e senha do Auth local. Nunca em produção.
VITE_AUTH_SENHA_LOCAL=
