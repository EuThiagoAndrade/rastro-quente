{
  "name": "rastro-quente",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test:governance": "node --test scripts/validate-governance.test.mjs",
    "test:prova-dados": "node --test \"scripts/prova-dados/*.test.mjs\"",
    "test:prototipo": "node --test \"scripts/prototipo/*.test.mjs\"",
    "check:governance": "node scripts/validate-governance.mjs",
    "test:rls": "supabase db reset && supabase test db && node --test --test-concurrency=1 scripts/banco/manifesto.test.mjs scripts/banco/api.test.mjs scripts/banco/executor.test.mjs scripts/banco/carga.test.mjs scripts/banco/reconstrucao.test.mjs scripts/banco/migracao.test.mjs",
    "medir:banco": "supabase db reset && node scripts/banco/medir.mjs",
    "medir:carga": "supabase db reset && node scripts/banco/medir-carga.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:servidor": "tsc -p tsconfig.servidor.json",
    "build": "vite build",
    "test:interface": "node --test tests/unit/*.test.mjs",
    "test:e2e": "supabase db reset && playwright test",
    "test:api": "supabase db reset && node --test --test-concurrency=1 \"scripts/api/*.test.mjs\"",
    "test:agentes": "node --test \"scripts/agentes/*.test.mjs\"",
    "prova:agentes": "supabase db reset && node --env-file-if-exists=.env scripts/agentes/prova-real.mjs",
    "medir:interface": "supabase db reset && node scripts/interface/medir-geometria.mjs",
    "conferir:areas": "supabase db reset && node --max-old-space-size=4096 scripts/areas/conferir.mjs",
    "conferir:lentes": "supabase db reset && node scripts/lentes/conferir.mjs",
    "conferir:combinacao": "supabase db reset && node scripts/lentes/conferir-combinacao.mjs",
    "conferir:sobreposicao": "supabase db reset && node scripts/lentes/conferir-sobreposicao.mjs",
    "medir:lentes": "supabase db reset && node scripts/interface/medir-lentes.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "pg": "8.23.1",
    "supabase": "2.122.1",
    "typescript": "7.0.2",
    "vercel": "65.16.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "leaflet": "1.9.4"
  }
}
